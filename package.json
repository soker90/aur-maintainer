{
  "name": "aur-maintainer",
  "description": "GitHub Action for automated Arch Linux AUR package maintenance",
  "version": "0.0.0",
  "author": "Eduardo Parra",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/soker90/aur-maintainer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soker90/aur-maintainer.git"
  },
  "bugs": {
    "url": "https://github.com/soker90/aur-maintainer/issues"
  },
  "keywords": [
    "actions",
    "aur",
    "arch-linux",
    "aur-maintenance"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check \"src/**/*.{js,jsx,ts,tsx,json,yml,yaml,md,css,scss,html}\" \"tests/**/*.{js,jsx,ts,tsx,json,yml,yaml,md,css,scss,html}\" \"action.yml\" \"action.yaml\" \"package.json\" \"tsconfig.json\" \"jest.config.js\" \"rollup.config.ts\" \".github/workflows/*.yml\" --ignore-path .prettierignore --no-error-on-unmatched-pattern",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.1",
    "ts-jest": "^29.4.14",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "@actions/http-client@3.0.2": {
      "undici": "6.29.0"
    },
    "@actions/http-client@4.0.0": {
      "undici": "6.29.0"
    }
  }
}
